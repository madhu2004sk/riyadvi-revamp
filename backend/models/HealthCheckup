const mongoose = require("mongoose");

const healthCheckupSchema = new mongoose.Schema(
    {
        businessName: {
            type: String,
            required: true,
            trim: true,
        },

        industry: {
            type: String,
            trim: true,
        },

        currentTechnology: {
            type: String,
            trim: true,
        },

        businessChallenges: {
            type: String,
            trim: true,
        },

        goals: {
            type: String,
            trim: true,
        },

        name: {
            type: String,
            required: true,
            trim: true,
        },

        email: {
            type: String,
            required: true,
            trim: true,
            lowercase: true,
        },

        phone: {
            type: String,
            trim: true,
        },
    },
    {
        timestamps: true,
    }
);

module.exports = mongoose.model("HealthCheckup", healthCheckupSchema);